# Supabase Configuration for Frontend React App
# Replace these values with your actual Supabase project credentials from https://app.supabase.com

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-actual-anon-public-key-here
# Canonical origin for the dedicated Religious Portal (Portal do Confrade).
# In EasyPanel / production, configure to https://portal.brm.org.br
VITE_PORTAL_PUBLIC_URL=https://portal.brm.org.br
